        <a class="card" href="#" card-id="main.party_affairs" title="Party Affairs"><img class="card-img" src="img/Vorwaerts_nr_1.png"></a>
    </li>
    <li class="deck">
        <a class="card" href="#" card-id="main.gov_affairs" title="Government Affairs"><img class="card-img" src="img/reichstag_2.jpg"></a>
    </li>
    <li class="deck">
