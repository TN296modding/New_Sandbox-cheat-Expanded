[? if spd_leader = "Wels" : <ul class="decks"><li class="deck"><a class="card" href="#" card-id="status.wels" title="Otto Wels"><img class="card-img" src="img/portraits/WelsOtto.jpg"></a>SPD Leader: Otto Wels (Centre)</li></ul> ?]
[? if spd_leader = "Wissell" : <ul class="decks"><li class="deck"><a class="card" href="#" card-id="status.wissell" title="Rudolf Wissell"><img class="card-img" src="img/portraits/WissellRudolf.jpg"></a>SPD Leader: Rudolf Wissell (Labor)</li></ul> ?]

